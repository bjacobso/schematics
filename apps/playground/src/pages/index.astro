---
import Document from "../layouts/Document.astro";
import Landing from "../Landing";
import "../landing/landing.css";
---
<Document title="Schematics — Your app's hidden rules, as data" homepage>
  <Fragment slot="head">
    <meta
      name="description"
      content="Every app hides a second program. Schematics is a family of small Effect Schema libraries — algebra, predicates, logic, workflow, core, and filesystem — that turn relationships, rules, behavior, and processes into data you can inspect."
    />
    <link rel="canonical" href="https://schematics.run/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Schematics — Every app hides a second program." />
    <meta
      property="og:description"
      content="Small Effect Schema libraries that turn relationships, rules, behavior, and processes into data you can inspect, store, test, and explain."
    />
    <meta property="og:url" content="https://schematics.run/" />
    <meta name="twitter:card" content="summary" />
  </Fragment>
  <!-- JSX prose and diagrams are rendered once at build time, without hydration. -->
  <div id="root"><Landing /></div>
  <script>
    import { bootHostedWorkspace } from "../hosted-shell";
    import { startHomepage } from "../landing/client";
    if (/\/w\/[^/]+\/?$/.test(location.pathname)) {
      await bootHostedWorkspace();
    } else {
      startHomepage();
    }
  </script>
</Document>
