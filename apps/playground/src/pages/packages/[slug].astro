---
import Document from "../../layouts/Document.astro";
import PackageLanding from "../../PackageLanding";
import { packages, type PackageName } from "../../landing/packages";
import { pitches } from "../../landing/pitches";
import "../../landing/landing.css";
import "../../landing/package.css";

export function getStaticPaths() {
  return packages.map((pkg) => ({ params: { slug: pkg.name }, props: { name: pkg.name } }));
}
interface Props { name: PackageName; }
const { name } = Astro.props;
const pkg = packages.find((pkg) => pkg.name === name)!;
const pitch = pitches[name];
const title = `@schema-reflection/${name} — ${pkg.title}`;
const canonical = new URL(`${import.meta.env.BASE_URL}packages/${name}/`, Astro.site).href;
---
<Document title={title}>
  <Fragment slot="head">
    <meta name="description" content={pitch.description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={pitch.description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
  </Fragment>
  <PackageLanding pkg={pkg} pitch={pitch} />
  <script>
    import { startHomepage } from "../../landing/client";
    startHomepage();
  </script>
</Document>
